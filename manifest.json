{
  "manifest_version": 3,
  "name": "YouTube Real-Time Semantic & Multimodal Verifier",
  "version": "3.2.0",
  "description": "On-device preview-scene assessment. Does not verify factual claims or publisher identity.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.ytimg.com/*",
    "*://*.googlevideo.com/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}